/* TESTE 02 - If / Else
   Compara dois números e exibe qual é o maior.
   Também testa if sem else. */

int x = 15;
int y = 8;
bool maior;

maior = x > y;

if (maior) {
    write(x);
}

if (x > y) {
    write(1);
} else {
    write(0);
}

/* Testa condição composta */
bool cond;
cond = x > 5 && y < 10;
if (cond) {
    write(99);
}

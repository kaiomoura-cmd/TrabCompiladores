/* TESTE 04 - For com declaração inline
   Calcula n! (fatorial de 5) usando for
   com declaração da variável de controle inline. */

int fatorial = 1;

for (int i = 1; i <= 5; i = i + 1) {
    fatorial = fatorial * i;
}

/* Esperado: 120 */
write(fatorial);

/* Segundo for: soma dos quadrados de 1 a 4 */
int soma_quadrados = 0;
for (int k = 1; k <= 4; k = k + 1) {
    int quadrado;
    quadrado = k * k;
    soma_quadrados = soma_quadrados + quadrado;
}

/* Esperado: 1+4+9+16 = 30 */
write(soma_quadrados);

/* TESTE Etapa 2 - Continue
   Testa continue dentro de while.
   Continue pula o resto do corpo e vai
   para a próxima iteração. */

/* Continue em while: soma apenas números pares */
int i = 0;
int soma = 0;
bool rodando;
rodando = i < 10;

while (rodando) {
    i = i + 1;

    /* Se ímpar, pula */
    bool eh_impar;
    eh_impar = i != (i / 2) * 2;
    if (eh_impar) {
        rodando = i < 10;
        continue;
    }

    soma = soma + i;
    rodando = i < 10;
}
write(soma);               /* Esperado: 2+4+6+8+10 = 30 */

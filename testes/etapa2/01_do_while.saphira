/* TESTE Etapa 2 - Do/While
   Executa o corpo pelo menos uma vez antes
   de verificar a condição. Compara com while. */

int i = 5;
bool rodando;

/* While comum: condição falsa de início → não executa */
int cont_while = 0;
rodando = i < 3;
while (rodando) {
    cont_while = cont_while + 1;
    i = i + 1;
    rodando = i < 3;
}
write(cont_while);         /* Esperado: 0 */

/* Do/While: executa uma vez mesmo com condição falsa */
int j = 5;
int cont_do = 0;
bool cond;

cond = j < 3;
do {
    cont_do = cont_do + 1;
    j = j + 1;
    cond = j < 3;
} while (cond);
write(cont_do);            /* Esperado: 1 */

/* Do/While que executa múltiplas vezes */
int k = 0;
int soma = 0;
bool continuar;
continuar = k < 5;
do {
    soma = soma + k;
    k = k + 1;
    continuar = k < 5;
} while (continuar);
write(soma);               /* Esperado: 0+1+2+3+4 = 10 */

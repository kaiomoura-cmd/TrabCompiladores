/* TESTE Etapa 2 - Operações com strings
   Declara strings, atribuição de literal e concatenação.
   (read() removido pois bloqueia em testes automatizados) */

string s1;
string s2;

/* Atribuição direta de literal string */
s1 = "Ola ";
s2 = "Mundo";

/* Concatenação */
s1 + s2;

write(s1);                 /* Esperado: OlaMundo */

/* Segunda concatenação */
string s3;
s3 = "!!!";
s1 + s3;

write(s1);                 /* Esperado: OlaMundo!!! */

/* TESTE ETAPA 3 - Matrizes Irregulares (Jagged)
   Cada linha pode ter tamanho diferente.
   Acesso transparente via m[i][j]. */

int jagged[3][] = {{1, 2}, {3, 4, 5}, {6}};

write("Linha 0 (2 cols): \n");
write(jagged[0][0]);
write(jagged[0][1]);

write("Linha 1 (3 cols): \n");
write(jagged[1][0]);
write(jagged[1][1]);
write(jagged[1][2]);

write("Linha 2 (1 col): \n");
write(jagged[2][0]);

/* TESTE 07 - Colisão de nomes: variáveis chamadas t1, t2, t3
   O compilador gera temporários t1, t2, t3...
   Este teste garante que NÃO há colisão de nomes. */

int t1 = 100;
int t2 = 200;
int t3 = 300;
int resultado;

/* O compilador vai gerar temporários t4, t5... (pula t1,t2,t3) */
resultado = t1 + t2 + t3;

write(t1);        /* Esperado: 100 */
write(t2);        /* Esperado: 200 */
write(t3);        /* Esperado: 300 */
write(resultado); /* Esperado: 600 */

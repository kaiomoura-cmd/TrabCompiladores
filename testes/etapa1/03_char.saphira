/* TESTE Etapa 1 - Operações com char
   Declaração, atribuição, comparação
   e operações básicas com o tipo char. */

char letra = 'Z';
write(letra);             /* Esperado: Z */

/* Comparação de chars */
bool igual;
igual = letra == 'Z';
write(igual);             /* Esperado: 1 (true) */

bool menor;
menor = 'A' < 'B';
write(menor);             /* Esperado: 1 (true) */

/* Múltiplos chars */
char c1 = 'X';
char c2 = 'Y';
write(c1);                /* Esperado: X */
write(c2);                /* Esperado: Y */

/* Char inicializado com outro char */
char copia;
copia = letra;
write(copia);             /* Esperado: Z */

/* Teste com valor ASCII */
char ascii = 'A';
write(ascii);             /* Esperado: A */

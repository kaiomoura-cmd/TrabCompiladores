/* TESTE 01 - Operações básicas e write
   Declara variáveis com e sem atribuição direta,
   faz aritmética e exibe os resultados. */

int a = 10;
int b = 3;
int soma;
int diferenca;
int produto;
int quociente;

soma      = a + b;
diferenca = a - b;
produto   = a * b;
quociente = a / b;

write(soma);
write(diferenca);
write(produto);
write(quociente);
